{
  "name": "philo-rag-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:restricted": "node --require ./tools/net-use-shim.cjs node_modules/vite/bin/vite.js build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run",
    "test:restricted": "node --require ./tools/net-use-shim.cjs node_modules/vitest/vitest.mjs run --configLoader runner --pool=threads --no-file-parallelism",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
