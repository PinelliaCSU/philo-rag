pytest-of-*/
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# RAG runtime outputs
outputs/
logs/
*.log

# Generated vector stores and indexes
store/*
!store/.gitkeep

