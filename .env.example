# 复制为 .env 后填入真实密钥。.env 已在 .gitignore 中，不会被提交。
# config.yaml 里对应写法：answer.api_key: ${DASHSCOPE_API_KEY}

# 阿里云百炼（DashScope）API Key —— 生成层使用
# 获取：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 若改用其它 OpenAI 兼容服务，可自行增加变量，并在 config.yaml 中引用，例如：
# OPENAI_API_KEY=sk-...
# SILICONFLOW_API_KEY=sk-...
